# Copy to .env and source it manually if you prefer. The application does not
# load .env files automatically. Never commit real tokens.

# Optional: enables authenticated Hub requests and higher rate limits.
# Create a scoped read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: override the local SQLite database path.
# Default on macOS/Linux: ~/.local/share/ethi-asr-bench/records.db
# Default on Windows: %LOCALAPPDATA%\ethi-asr-bench\records.db
ETHI_ASR_DB_PATH=

# Optional provider tuning.
ETHI_ASR_HF_TIMEOUT=30
ETHI_ASR_HF_MAX_RETRIES=3
ETHI_ASR_HF_BACKOFF=0.5
ETHI_ASR_LOG_LEVEL=WARNING
